# App → Supabase (required to leave mock mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for guest COD order inserts (server-only — never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Optional
NEXT_PUBLIC_USE_MOCK_DATA=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Polar payments disabled — COD only. Leave unset.
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# POLAR_PRODUCT_ID=
# POLAR_ORG_ID=
